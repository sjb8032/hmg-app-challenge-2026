<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 실제로 쓰는 API의 최소 권한만 선언한다. 권한 목록은 docs/SETUP.md 참고 -->

    <!-- Vehicle SDK: 도어 상태 조회 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <!-- NaviHelper SDK: 경로·주행 정보 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PleosApp">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
